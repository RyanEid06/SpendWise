# ---------------------------
# Backend-only configuration
# ---------------------------
# Never put GEMINI_API_KEY in a VITE_* variable.
GEMINI_API_KEY=

# Optional model override.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=22000
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Exact browser/WebView origins only. No wildcard credentialed origins.
ALLOWED_ORIGINS=https://localhost,http://localhost:3000

# Local development only. Render requires external PostgreSQL (see WP35.1 runbook).
SPENDWISE_INSTALLATION_STORE_PATH=.spendwise-security/installations.json
# BACKEND_HOST_PROFILE=render_free
# SPENDWISE_AUTH_STORE=postgres
# SPENDWISE_AUTH_DATABASE_URL=postgresql://RUNTIME_ROLE:SECRET@POOLED_HOST/DATABASE?sslmode=verify-full
# Database URL is backend-only; never use VITE_* or commit a real value.

# Emergency deny-list; comma-separated installation IDs.
SPENDWISE_DENIED_INSTALLATION_IDS=

# Optional abuse/cost tuning. Defaults are defined in server/config.ts.
# SPENDWISE_REGISTRATION_HOURLY_LIMIT=5
# SPENDWISE_REGISTRATION_DAILY_LIMIT=20
# SPENDWISE_AI_INSTALLATION_PER_MINUTE=30
# SPENDWISE_AI_IP_PER_MINUTE=60
# SPENDWISE_AI_INSTALLATION_PER_DAY=500
# SPENDWISE_AI_GLOBAL_PER_DAY=5000

# Transitional pre-WP31 compatibility only. New APKs do not use this value.
# Remove after the upgrade window and unset it on the backend.
SPENDWISE_API_TOKEN=
SPENDWISE_LEGACY_AUTH_UNTIL=

# Optional server-only salt for pseudonymous security telemetry scope hashes.
SPENDWISE_TELEMETRY_SALT=

# ---------------------------
# Frontend / APK build config
# ---------------------------
# Production Android must point to HTTPS.
VITE_API_BASE_URL=
