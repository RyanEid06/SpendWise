# ---------------------------
# Backend-only configuration
# ---------------------------
# Never put GEMINI_API_KEY in a VITE_* variable.
GEMINI_API_KEY=

# Optional model override. Default in server.ts is gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional provider timeout in milliseconds. Clamped to 5-40 seconds; default 22000.
GEMINI_TIMEOUT_MS=22000

# Required for production AI endpoints.
# Use a long random value. This is an access gate, not user authentication.
SPENDWISE_API_TOKEN=

# Comma-separated exact browser/WebView origins.
# Capacitor Android with androidScheme=https uses https://localhost.
ALLOWED_ORIGINS=https://localhost,http://localhost:5173

# ---------------------------
# Frontend / APK build config
# ---------------------------
# Leave blank for same-origin web/dev.
# For Android set this to the deployed HTTPS backend, e.g.
# https://spendwise-api.example.com
VITE_API_BASE_URL=

# Set to the same value as SPENDWISE_API_TOKEN.
# IMPORTANT: VITE_* values are embedded in the client/APK and are extractable.
# This token only reduces casual unauthorized use; GEMINI_API_KEY remains the real secret.
VITE_API_ACCESS_TOKEN=


# Optional server-only fallback models. Used for transient provider unavailability or model-specific rate limits.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
